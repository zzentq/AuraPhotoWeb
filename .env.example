# Базовый URL бекенда (без завершающего слэша)
VITE_API_BASE_URL=http://localhost:8000

# Имя Telegram-бота (для реферальной ссылки)
VITE_BOT_USERNAME=aura_photo_bot

# Dev-режим: использовать тестовую авторизацию вне Telegram.
# true  — вне Telegram авторизуется через /auth/telegram/test?user_id=1
# false — вне Telegram покажет экран "открой в Telegram"
VITE_DEV_AUTO_LOGIN=true
VITE_DEV_USER_ID=1
